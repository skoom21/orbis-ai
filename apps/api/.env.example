# ============================================================
# Orbis AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-prod

# --- Supabase ---
# Dashboard → Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Google Gemini ---
GOOGLE_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Redis (Upstash or local) ---
REDIS_URL=redis://localhost:6379
# For Upstash: rediss://:password@host:port

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Flight Search (SerpApi) ---
# Free tier: 250 searches/month — sign up at https://serpapi.com
SERPAPI_KEY=your-serpapi-key

# --- Hotel Search (liteAPI) ---
# Sandbox key works for testing. Get prod key at https://liteapi.travel
LITEAPI_KEY=sand_583409da-28e0-4ca1-ad0e-ddd61b78cb85

# --- Stripe Payments ---
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- Logging ---
LOG_LEVEL=INFO
